# gates_of_heck configuration. All keys optional; delete what you don't use.
# Full key reference: docs/config.md in the gates_of_heck checkout
# (or .gatesrc.example there for a commented starter with every key).
GOH_MAX_LINES=500                 # file-length cap; unset disables the check
# GOH_EXCLUDE='vendor/|\.generated\.'   # shared vendor/generated exemption
# GOH_ALLOW='<glyph>'                          # extra permitted characters (keep minimal)
# GOH_LINE_EXCLUDE='third_party/'       # length-only alias
# GOH_PY_COV_MIN=95
# GOH_SWIFT_MODE=xcode            # or spm
# GOH_SWIFT_SCHEME=MyAppTests
# GOH_SWIFT_COV_MIN=95
# GOH_MAX_SCRATCH_GB=25 etc. live OUTSIDE the gates since v0.8.0 — set them
# in the environment for the scripts repo's bin/disk_hygiene.sh, not here.
# Every scanner's floor (goh v0.27.0, docs/config.md): a full-scope scan that
# reads less than this has lost its subject and is red, not clean. Nine tenths
# of what each read on 2026-10-14 (the house rule; a count of 1 floors at 1);
# lower one with the tree in the same commit, never to absorb a scan that went
# blind. The checkout floor guards R2 (persist-credentials: false).
GOH_EMOJI_MIN_FILES=51                # read 57
GOH_CONFLICT_MARKERS_MIN_FILES=57     # read 64
GOH_FILE_LENGTH_MIN_FILES=5           # read 6
GOH_SECRETS_MIN_FILES=51              # read 57
GOH_SHELL_LINT_MIN_FILES=3            # read 4
GOH_EARLY_EXIT_PIPE_MIN_FILES=8       # read 9
GOH_DEAD_AFTER_EXEC_MIN_FILES=8       # read 9
GOH_BARE_HOOK_INDEX_MIN_FILES=8       # read 9
GOH_BARE_PYTHON_MIN_FILES=5           # read 6
GOH_CHECKOUT_CREDENTIALS_MIN_FILES=1  # read 1
GOH_MD_LINKS_MIN_LINKS=91             # read 102
